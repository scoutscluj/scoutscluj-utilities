DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scoutscluj_utilities

# Railway injects PORT automatically. API_PORT and WEB_PORT are local fallbacks.
API_PORT=3000
WEB_PORT=5173

WEB_ORIGIN=http://localhost:5173
WEB_ORIGINS=http://localhost:5173,http://localhost:5174
PUBLIC_API_BASE_URL=http://localhost:3000
PUBLIC_APP_VERSION=0.0.0-dev
PUBLIC_COMMIT_HASH=local
# Set to true only when explicitly testing PWA behavior outside production preview.
PUBLIC_ENABLE_DEV_PWA=false

AUTH_SESSION_SECRET=replace-with-a-long-random-secret
ORGO_OAUTH_BASE_URL=https://membri.scout.ro
ORGO_API_TOKEN=
# Enable member contact/status writes only after verifying the tenant contract.
ORGO_MEMBER_WRITES_ENABLED=false
ORGO_ACTIVE_STATUS=ACTIVE
ORGO_WITHDRAWN_STATUS=
ORGO_LOCAL_CENTER_ID=
ORGO_LOCAL_CENTER_NAME=Centrul Local Cluj
ORGO_OAUTH_CLIENT_ID=replace-me
ORGO_OAUTH_CLIENT_SECRET=replace-me
ORGO_OAUTH_REDIRECT_URI=http://localhost:3000/api/orgo/callback
# 32 random bytes encoded as 64 hex characters; server-only token encryption.
ORGO_TOKEN_ENCRYPTION_KEY=

# Keez API credentials. Keep real values only in deployment secrets.
KEEZ_ENVIRONMENT=staging
KEEZ_APP_ID=replace-me
KEEZ_CLIENT_ID=replace-me
KEEZ_CLIENT_SECRET=replace-me
KEEZ_DOCUMENT_EMAIL_EXPECTED_SENDER=cluj.napoca@scout.ro
KEEZ_DOCUMENT_EMAIL_RECIPIENT=replace-with-company-cui@keez.ro

# Gmail API sender for Keez document email handoff.
FINANCE_GMAIL_CLIENT_ID=replace-me
FINANCE_GMAIL_CLIENT_SECRET=replace-me
FINANCE_GMAIL_REFRESH_TOKEN=replace-me
FINANCE_GMAIL_SENDER_EMAIL=cluj.napoca@scout.ro

# Administrator-managed payment credentials are encrypted with this non-exportable KMS key.
AWS_REGION=eu-central-1
PAYMENT_CONFIG_KMS_KEY_ID=
MEMBERSHIP_API_ORIGIN=http://localhost:3000
MEMBERSHIP_WEB_ORIGIN=http://localhost:5173

# Common NETOPIA IPN verification key (LIVE and SANDBOX). Never used to start payments.
# Literal \n is normalized at runtime. Set this on the API service only.
NETOPIA_IPN_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAy6pUDAFLVul4y499gz1P\ngGSvTSc82U3/ih3e5FDUs/F0Jvfzc4cew8TrBDrw7Y+AYZS37D2i+Xi5nYpzQpu7\nryS4W+qvgAA1SEjiU1Sk2a4+A1HeH+vfZo0gDrIYTh2NSAQnDSDxk5T475ukSSwX\nL9tYwO6CpdAv3BtpMT5YhyS3ipgPEnGIQKXjh8GMgLSmRFbgoCTRWlCvu7XOg94N\nfS8l4it2qrEldU8VEdfPDfFLlxl3lUoLEmCncCjmF1wRVtk4cNu+WtWQ4mBgxpt0\ntX2aJkqp4PV3o5kI4bqHq/MS7HVJ7yxtj/p8kawlVYipGsQj3ypgltQ3bnYV/LRq\n8QIDAQAB\n-----END PUBLIC KEY-----"

# Public Google Calendar sources; credentials are API-server only.
# See docs/dashboard-calendars.md for setup and source visibility requirements.
GOOGLE_CALENDAR_API_KEY=
GOOGLE_CALENDAR_EVENTS_ID=c_f3605cf4dbf3bbabf28c1ffbd50611905c9b3da5941c5556ace54a0ab3d456be@group.calendar.google.com
GOOGLE_CALENDAR_HEADQUARTERS_ID=c_456e2c5db77124a1f42e417621e5fb1f70aec044fff06ae072c4ed54fe53675e@group.calendar.google.com
GOOGLE_CALENDAR_DAILY_REQUEST_LIMIT=2000

# Optional transactional email transport for activity registration confirmations.
# HTTPS endpoint accepts {to, subject, text}; bearer token stays on the API server.
# It must honor the Idempotency-Key header. Pending confirmations retry after configuration.
ACTIVITY_MAIL_ENDPOINT=
ACTIVITY_MAIL_TOKEN=

# Optional local executable overrides for the fixed Word agreement renderer.
PARENTAL_CONSENT_PYTHON=python3
LIBREOFFICE_PATH=libreoffice
