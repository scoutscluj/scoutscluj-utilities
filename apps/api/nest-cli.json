{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "modules/parental-consent/fixed-template/*",
        "outDir": "dist"
      },
      {
        "include": "modules/kitchen/fixtures/legacy-catalog/*.json",
        "outDir": "dist"
      },
      {
        "include": "modules/parental-consent/seed-assets/*.png",
        "outDir": "dist"
      }
    ]
  }
}
